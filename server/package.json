{
  "name": "chat-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "detect-dead-code": "knip --include exports,types,files,dependencies",
    "prepare": "[ \\\"$NODE_ENV\\\" = production ] && exit 0; husky install",
    "build": "nest build",
    "start:api": "APPLICATION_MODE=api nest start --debug --config nest-cli.api.json",
    "dev:api": "APPLICATION_MODE=api nest start --watch --debug --config nest-cli.api.json",
    "debug:api": "APPLICATION_MODE=api nest start --debug --watch --config nest-cli.api.json",
    "start:api:production": "APPLICATION_MODE=api node dist/main.api",
    "start:worker": "APPLICATION_MODE=worker nest start --debug --config nest-cli.worker.json",
    "dev:worker": "APPLICATION_MODE=worker nest start --watch --debug --config nest-cli.worker.json",
    "debug:worker": "APPLICATION_MODE=worker nest start --debug --watch --config nest-cli.worker.json",
    "start:worker:production": "APPLICATION_MODE=worker node dist/main.worker",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:dev": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:create-migration": "wrap () { yarn prisma:create-down-migration && yarn prisma:create-up-migration $* && mv down.sql $(find prisma/migrations -type d -iname \"*_$*\"); }; wrap",
    "prisma:create-up-migration": "prisma migrate dev --create-only --name",
    "prisma:create-down-migration": "npx prisma migrate diff --from-schema-datamodel prisma/schema.prisma --to-schema-datasource prisma/schema.prisma --script > down.sql",
    "prisma:push": "prisma db push",
    "lint": "eslint \"{src,test,deploy}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,deploy}/**/*.ts\" --fix",
    "test": "jest --config jest.config.ts --runInBand",
    "test:ci": "jest --config jest.config.ts --ci",
    "test:watch": "jest --watch  --config jest.config.ts ",
    "test:cov": "jest --coverage --config jest.config.ts",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand  --config jest.config.ts",
    "auth": "node ./npm-auth"
  },
  "dependencies": {
    "@nestjs/common": "^8.2.1",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^8.2.1",
    "@nestjs/microservices": "^8.2.1",
    "@nestjs/platform-express": "^8.2.1",
    "@nestjs/terminus": "^8.0.6",
    "@prisma/client": "^3.15.2",
    "@types/uuid": "^8.3.1",
    "amqplib": "^0.10.3",
    "axios": "^0.27.2",
    "cache-manager": "^3.6.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "flat": "^5.0.2",
    "ioredis": "^4.28.1",
    "joi": "^17.4.2",
    "lodash": "^4.17.21",
    "nock": "^13.2.1",
    "pino": "^8.15.4",
    "prisma": "^3.15.2",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.3.0",
    "safe-json-stringify": "^1.2.0",
    "source-map-support": "^0.5.21",
    "uuid": "^8.3.2"
  },
  "resolutions": {
    "joi": "17.8.3"
  },
  "devDependencies": {
    "@automock/jest": "^1.1.0",
    "@jest/types": "^27.4.2",
    "@nestjs/cli": "^8.1.1",
    "@nestjs/schematics": "^8.0.5",
    "@nestjs/testing": "^8.2.1",
    "@types/amqplib": "^0.10.1",
    "@types/cache-manager": "^3.4.3",
    "@types/express": "^4.17.18",
    "@types/ioredis": "^4.28.1",
    "@types/jest": "^27.0.3",
    "@types/joi": "^17.2.3",
    "@types/lodash": "^4.14.177",
    "@types/node": "^16.4.13",
    "@types/pino": "^7.0.5",
    "@types/safe-json-stringify": "^1.1.2",
    "@types/source-map-support": "^0.5.4",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "eslint": "^8.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-unicorn": "^39.0.0",
    "husky": "^8.0.1",
    "jest": "28",
    "jest-junit": "^14.0.1",
    "knip": "^2.30.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.3.2",
    "supertest": "^6.1.4",
    "ts-jest": "28",
    "ts-node": "^10.2.0",
    "typescript": "^4.9.5"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --ext .ts --fix"
    ]
  },
  "jest-junit": {
    "outputDirectory": "test-reports",
    "ancestorSeparator": " › ",
    "uniqueOutputName": "false",
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
